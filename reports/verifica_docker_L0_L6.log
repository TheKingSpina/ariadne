FROM rust:1.85.0-bookworm@sha256:0ff31c9ffa641a62e48d543fb00b4960955ea375f40776f40f585b89e654cc5e
WORKDIR /source
ADD source.tar /source/
RUN cargo fetch --locked && cargo build --release --locked --offline
COPY probe.rs /verify/probe.rs
RUN rustc --edition=2021 /verify/probe.rs --extern ariadne=/source/target/release/libariadne.rlib -L dependency=/source/target/release/deps -o /verify/probe
COPY verify.sh /verify/verify.sh
COPY r1-r2.txt /verify/r1-r2.txt
ENTRYPOINT ["bash", "/verify/verify.sh"]


=== VERIFICATION DEFINITION probe.rs ===
use ariadne::{Log, EventType, Payload, Value};
use ariadne::valuation::{run_pair, fold_run, wilcoxon_one_sided_greater, TEST_TASKS, ValuationError};
fn main() {
    let args: Vec<String> = std::env::args().collect();
    match args[1].as_str() {
        "gate" => {
            let mut log = Log::genesis(1000).unwrap();
            log.append(1, EventType::Sense, Payload::from_pairs([
                ("cue", Value::from("cue:00")), ("extra", Value::Int(1))
            ])).unwrap();
            let negative = fold_run(&log);
            println!("NEGATIVE extra payload key: {negative:?}");
            assert_eq!(negative, Err(ValuationError::Protocol));
            let pair = run_pair(1000);
            let log = Log::from_jsonl(&pair.memoria.jsonl).unwrap();
            let positive = fold_run(&log);
            println!("POSITIVE generated memory run: {positive:?}");
            assert_eq!(positive.unwrap(), (pair.memoria.learning_milli, pair.memoria.test_milli));
            println!("GATE negative rejected / positive accepted: PASS");
        }
        "seed" => {
            let seed = args[2].parse().unwrap();
            let r = run_pair(seed);
            let m = r.memoria.test_milli / TEST_TASKS as i64;
            let c = r.controllo.test_milli / TEST_TASKS as i64;
            println!("seed={seed} memoria_milli={m} controllo_milli={c} diff={} replay_reported={}", m-c, r.replay_ok);
            for (arm, output) in [("memoria", &r.memoria), ("controllo", &r.controllo)] {
                let log = Log::from_jsonl(&output.jsonl).unwrap();
                log.verify().unwrap();
                println!("seed={seed} arm={arm} events={} head_hash={}", log.events().len(), log.events().last().unwrap().hash);
            }
            assert!(r.replay_ok);
            println!("DIFF {}", m-c);
        }
        "stats" => {
            let input = std::fs::read_to_string(&args[2]).unwrap();
            let diffs: Vec<i64> = input.lines().map(|s| s.parse().unwrap()).collect();
            assert_eq!(diffs.len(), 100);
            let r = wilcoxon_one_sided_greater(&diffs).unwrap();
            println!("Wilcoxon implementation=src/valuation.rs n={} W={} p={:.17e} Delta={:.17} n_pairs={}", r.n, r.w, r.p, r.delta_bar, diffs.len());
            assert!(r.p < 0.01 && r.delta_bar >= 0.30);
        }
        _ => panic!("unknown verification mode"),
    }
}


=== VERIFICATION DEFINITION verify.sh ===
#!/bin/bash
set -u
export CARGO_NET_OFFLINE=true
echo '=== CONTAINER START ==='
date -u
rustc --version --verbose
cargo --version
cat /etc/os-release
dpkg-query -W
sha256sum Cargo.lock /verify/probe.rs /verify/verify.sh
echo '=== PINNED CARGO DEPENDENCIES ==='
cat Cargo.lock
echo '=== BLOCK 1: NEGATIVE/POSITIVE GATE ==='
/verify/probe gate
b1=$?
echo "BLOCK1_EXIT=$b1"
echo '=== BLOCK 2: SINGLE E2E L0 THROUGH L6 ==='
echo 'FAIL: no tracked unified L0-L6 scenario exists. Suite is not substituted for an E2E execution.'
echo 'Law L6.4 makes L1-L5 use optional; no signed cross-level scenario parameters supplied. No new scenario invented.'
find tests -maxdepth 1 -type f | sort
echo '=== BLOCK 3: R1/R2 CODE EVIDENCE ==='
echo 'Scope explicitly identified from reports/compact_review_l0_l3_b2770bd.md: L2 R1 and R2.'
cat /verify/r1-r2.txt
nl -ba src/selection.rs | sed -n '19,69p'
grep -F 'mentioned.extend(edge_mentions(v,&view)?)' src/selection.rs && grep -F 'let tau=config.ok_or(L2Error::Config)?.1;' src/selection.rs
b3=$?
echo "BLOCK3_CODE_CHECK_EXIT=$b3"
echo '=== BLOCK 4: L6 CORPUS 1000-1099 ==='
echo 'Timeout=5 seconds per pair (signed law L6.11); externally enforced with GNU timeout, SIGKILL. Startup included. No retries or seed exclusions.'
timeout --version
violations=0
: > /verify/diffs.txt
for seed in $(seq 1000 1099); do
  timeout --signal=KILL 5s /verify/probe seed "$seed" > /verify/current-seed.txt 2>&1
  rc=$?
  cat /verify/current-seed.txt
  echo "seed=$seed exit=$rc"
  if [ "$rc" -ne 0 ]; then violations=$((violations+1)); else grep '^DIFF ' /verify/current-seed.txt | cut -d' ' -f2 >> /verify/diffs.txt; fi
done
/verify/probe stats /verify/diffs.txt
stats_rc=$?
echo "CORPUS_VIOLATIONS=$violations STATS_EXIT=$stats_rc"
echo 'LIMIT: replay_reported only checks chain, JSONL roundtrip and reward fold; it does not independently regenerate all policy decisions (L6.9).'
echo '=== SUPPLEMENT: EXISTING SUITE (NOT E2E) ==='
cargo test --locked --offline
debug_rc=$?
cargo test --release --locked --offline
release_rc=$?
echo "SUITE_DEBUG_EXIT=$debug_rc SUITE_RELEASE_EXIT=$release_rc"
echo '=== SUMMARY ==='
if [ "$b1" -eq 0 ]; then echo 'BLOCK 1 PASS'; else echo 'BLOCK 1 FAIL'; fi
echo 'BLOCK 2 FAIL: unified E2E absent / scenario unspecified'
if [ "$b3" -eq 0 ]; then echo 'BLOCK 3 PASS (L2 R1/R2 code-presence check, reference 610b43c)'; else echo 'BLOCK 3 FAIL'; fi
if [ "$violations" -eq 0 ] && [ "$stats_rc" -eq 0 ]; then echo 'BLOCK 4 PASS (corpus execution, hard timeout, implemented Wilcoxon thresholds only)'; else echo 'BLOCK 4 FAIL'; fi
echo 'No acceptance verdict. Known replay limitation retained. No production logic or repository tests modified.'
if [ "$b1" -eq 0 ] && [ "$b3" -eq 0 ] && [ "$violations" -eq 0 ] && [ "$stats_rc" -eq 0 ] && [ "$debug_rc" -eq 0 ] && [ "$release_rc" -eq 0 ]; then exit 2; else exit 1; fi


