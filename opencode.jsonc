{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  // Conservata l'impostazione preesistente; la nuova configurazione non
  // richiede il vecchio Router né autorizza routing automatico dei modelli.
  "experimental": {
    "subagent_depth": 2
  },
  "mcp": {
    "servers": {
      "ariadne": {
        "type": "remote",
        "url": "http://127.0.0.1:8080/mcp",
        "oauth": false
      }
    }
  }
}
